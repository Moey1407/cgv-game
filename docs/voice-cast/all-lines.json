    "level": "any",
    "key": "echo:shattered",
    "direction": ""
  },
  {
    "id": "cinematic-opening-1",
    "who": "WREN",
    "text": "Dex, open the service door. I have the drive.",
    "key": "cinematic:opening",
    "direction": "Breathless, urgent. A steel shutter is falling behind you."
  },
  {
    "id": "cinematic-opening-2",
    "who": "DEX",
    "text": "I'm sorry, Wren. I can't lose the whole crew.",
    "key": "cinematic:opening",
    "direction": "Quiet guilt under pressure. Do not shout; the choice has already been made."
  },
  {
    "id": "cinematic-opening-3",
    "who": "DEX",
    "text": "You want out? One job. Your name is on the gala list. We go back after closing.",
    "key": "cinematic:opening",
    "direction": "Measured persuasion. He needs Wren to trust him, but he is hiding something."
  },
  {
    "id": "cinematic-opening-4",
    "who": "DEX",
    "text": "You are a donor tonight. Copy the badge. Authorise the night entry. Then walk out.",
    "key": "cinematic:opening",
    "direction": "Low radio voice. Controlled, specific, almost too calm."
  },
  {
    "id": "cinematic-opening-5",
    "who": "WREN",
    "text": "Lens is live. The rings are mine, not lights in the room. A pulse maps the floor, but they can hear the ping.",
    "key": "cinematic:opening",
    "direction": "Wren checking her own equipment. Matter-of-fact and quietly confident, not a tutorial announcer."
  },
  {
    "id": "cinematic-after1-1",
    "who": "WREN",
    "text": "Access is authorised. I am outside. Tell me why we are waiting.",
    "key": "cinematic:after1",
    "direction": "Relieved, outside the gala. Wren wants a straight answer; no breathless chase."
  },
  {
    "id": "cinematic-after1-2",
    "who": "DEX",
    "text": "The Star goes into the safe after closing. Come back at one-thirty. The staff entrance will accept your copy.",
    "key": "cinematic:after1",
    "direction": "Dex explains the plan quietly and precisely. Persuasive, not a tutorial announcer."
  },
  {
    "id": "cinematic-after1-3",
    "who": "WREN",
    "text": "You handle the cameras. I handle the safe. Then I take my own way out.",
    "key": "cinematic:after1",
    "direction": "Professional agreement with an edge of distrust. Emphasise her own way out."
  },
  {
    "id": "cinematic-after2-1",
    "who": "WREN",
    "text": "Star secured. I am at the service door. Open the exit, Dex.",
    "key": "cinematic:after2",
    "direction": "Controlled urgency. The exit is not opening, but Wren still expects Dex to help."
  },
  {
    "id": "cinematic-after2-2",
    "who": "DEX",
    "text": "The policy pays more if they catch a thief. Sorry, Wren. Same as Marlowe.",
    "key": "cinematic:after2",
    "direction": "Cold reveal. No villain laughter. The apology is empty; Marlowe confirms the pattern."
  },
  {
    "id": "cinematic-after2-3",
    "who": "WREN",
    "text": "You left me in there on purpose. Radio is dead. The rig is local. I can make my own second operator.",
    "key": "cinematic:after2",
    "direction": "The betrayal lands, then Wren regains control. A short pause after purpose and dead."
  },
