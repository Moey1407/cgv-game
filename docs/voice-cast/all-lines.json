  {
    "id": "dex-any-safe-tumbler-1-1",
    "who": "DEX",
    "text": "One down.",
    "level": "any",
    "key": "safe:tumbler-1",
    "direction": ""
  },
  {
    "id": "dex-any-safe-tumbler-2-1",
    "who": "DEX",
    "text": "Two. One more.",
    "level": "any",
    "key": "safe:tumbler-2",
    "direction": ""
  },
  {
    "id": "dex-any-safe-opened-1",
    "who": "DEX",
    "text": "There she is. The Kestrel Star.",
    "level": "any",
    "key": "safe:opened",
    "direction": ""
  },
  {
    "id": "dex-any-door-vault-wing-1",
    "who": "DEX",
    "text": "Night entry authorised. Walk out through the lobby. We come back when the Star is in the safe.",
    "level": "any",
    "key": "door:vault-wing",
    "direction": ""
