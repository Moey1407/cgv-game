    "level": "2",
    "key": "safe:noise",
    "direction": ""
  },
  {
    "id": "wren-2-evidence-1",
    "who": "WREN",
    "text": "A radio intercept on the guard channel. That's Dex's voice.",
    "level": "2",
    "key": "evidence",
    "direction": ""
  },
  {
    "id": "dex-2-evidence-2",
    "who": "DEX",
    "text": "Leave the paperwork. We didn't come for paperwork.",
    "level": "2",
    "key": "evidence",
    "direction": ""
  },
  {
    "id": "dex-2-safe-opened-1",
    "who": "DEX",
    "text": "Open. Take the Star, then get back to the service fire door.",
    "level": "2",
    "key": "safe:opened",
    "direction": ""
  },
  {
    "id": "wren-2-diamond-taken-1",
    "who": "WREN",
