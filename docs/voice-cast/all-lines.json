[
  {
    "id": "dex-1-level-start-1",
    "who": "DEX",
    "text": "Your name is on the guest list. Okafor sees a donor. Link the camera tap at the east security desk first.",
    "level": "1",
    "key": "level:start",
    "direction": ""
  },
  {
    "id": "dex-1-pickpocket-complete-1",
    "who": "DEX",
    "text": "Smooth. Original stays on his belt. Get the copy authorised at the rear staff reader.",
    "level": "1",
    "key": "pickpocket:complete",
    "direction": ""
  },
  {
    "id": "wren-1-evidence-1",
    "who": "WREN",
    "text": "A security roster. Dex is on it. Why would Dex be on it?",
    "level": "1",
    "key": "evidence",
    "direction": ""
  },
  {
    "id": "dex-1-evidence-2",
    "who": "DEX",
    "text": "Wren? You've gone quiet. Keep moving.",
    "level": "1",
    "key": "evidence",
    "direction": ""
  },
  {
    "id": "dex-2-level-start-1",
    "who": "DEX",
    "text": "One-thirty. Same night. The badge got you inside; your donor cover is finished.",
    "level": "2",
    "key": "level:start",
    "direction": ""
  },
  {
    "id": "dex-2-door-tamper-circuit-1",
    "who": "DEX",
    "text": "Tamper circuit isolated. Now the dial. Briggs is still making rounds.",
    "level": "2",
    "key": "door:tamper-circuit",
    "direction": ""
  },
  {
    "id": "dex-2-door-tamper-circuit-2",
    "who": "DEX",
    "text": "He checks the safe once a lap. Need longer? Bounce a decoy into the archive.",
    "level": "2",
    "key": "door:tamper-circuit",
    "direction": ""
  },
  {
    "id": "dex-2-hazard-trip-1",
    "who": "DEX",
    "text": "Are you trying to set them off? Watch the pattern!",
    "level": "2",
    "key": "hazard:trip",
    "direction": ""
  },
  {
    "id": "dex-2-hazard-trip-2",
    "who": "DEX",
    "text": "Again? Crawl, jump or wait. It's not complicated.",
    "level": "2",
    "key": "hazard:trip",
    "direction": ""
  },
  {
    "id": "dex-2-player-detected-1",
    "who": "DEX",
    "text": "Briggs has you! Move!",
    "level": "2",
    "key": "player:detected",
    "direction": ""
  },
  {
    "id": "dex-2-player-detected-2",
    "who": "DEX",
    "text": "Seen. Of course. Hide, then hurry.",
    "level": "2",
    "key": "player:detected",
    "direction": ""
  },
  {
    "id": "dex-2-safe-tumbler-1-1",
